// Cloudflare Workers, static assets only: no server code, just `dist/` on Cloudflare's network.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raulmarquez-dev",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    // Serves the nearest 404.html with a real 404 status.
    "not_found_handling": "404-page",
    // Matches Astro's trailingSlash: 'always' (/about → /about/).
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Custom domains: Cloudflare creates their DNS records and certificates. Other subdomains
  // (traindia, the homelab tunnels) are untouched. www redirects to the root with a Redirect Rule.
  "routes": [
    { "pattern": "raulmarquez.dev", "custom_domain": true },
    { "pattern": "www.raulmarquez.dev", "custom_domain": true }
  ]
}
