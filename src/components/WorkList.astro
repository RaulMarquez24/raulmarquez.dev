---
import type { Locale } from '../i18n/ui';
import { type Project, projectSlug } from '../lib/content';
import ProjectVisual from './ProjectVisual.astro';
import WorkRow from './WorkRow.astro';

/**
 * Selected-work list. With a mouse, hovering a row shows the project's cover floating next to
 * the cursor; opening that project morphs the cover into the case-study hero. Hidden on touch;
 * no easing with reduced motion.
 */
interface Props {
  projects: Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
---

<div data-work-list>
  <ol>
    {projects.map((project, index) => <WorkRow project={project} index={index} locale={locale} />)}
  </ol>

  <div
    data-work-preview
    aria-hidden="true"
    class="pointer-events-none fixed top-0 left-0 z-20 hidden aspect-video w-64 overflow-hidden rounded-md opacity-0 transition-opacity duration-300 pointer-fine:block"
  >
    {
      projects.map((project, index) => (
        <div
          data-cover={index}
          data-transition={project.data.externalUrl ? undefined : `cover-${projectSlug(project)}`}
          class="absolute inset-0 opacity-0 transition-opacity duration-300"
        >
          <ProjectVisual project={project} variant="preview" class="size-full rounded-md" />
        </div>
      ))
    }
  </div>
</div>

<script>
  const list = document.querySelector<HTMLElement>('[data-work-list]');
  const preview = list?.querySelector<HTMLElement>('[data-work-preview]');

  if (list && preview) {
    const covers = [...preview.querySelectorAll<HTMLElement>('[data-cover]')];
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const target = { x: 0, y: 0 };
    const position = { x: 0, y: 0 };
    let scale = 0.92;
    let visible = false;
    let active = -1;
    let opened = -1;
    let frame = 0;

    const place = (event: PointerEvent) => {
      const width = preview.offsetWidth;
      const height = preview.offsetHeight;
      const flip = event.clientX + 32 + width > window.innerWidth;
      target.x = flip ? event.clientX - 32 - width : event.clientX + 32;
      target.y = Math.min(Math.max(event.clientY - height / 2, 8), window.innerHeight - height - 8);
    };

    const render = () => {
      const ease = reducedMotion.matches ? 1 : 0.18;
      position.x += (target.x - position.x) * ease;
      position.y += (target.y - position.y) * ease;
      scale += ((visible ? 1 : 0.92) - scale) * (reducedMotion.matches ? 1 : 0.2);
      preview.style.transform = `translate3d(${position.x}px, ${position.y}px, 0) scale(${scale})`;
      frame = visible || Math.abs(scale - 0.92) > 0.001 ? requestAnimationFrame(render) : 0;
    };

    const start = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    for (const row of list.querySelectorAll<HTMLAnchorElement>('[data-work-row]')) {
      const index = Number(row.dataset.workRow);

      row.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse') return;
        active = index;
        covers.forEach((cover, i) => {
          cover.style.opacity = i === index ? '1' : '0';
        });
        place(event);
        if (!visible) {
          position.x = target.x;
          position.y = target.y;
        }
        visible = true;
        preview.style.opacity = '1';
        preview.dataset.visible = 'true';
        start();
      });
      row.addEventListener('pointermove', (event) => {
        place(event);
        start();
      });
      row.addEventListener('click', (event) => {
        const plain = event.button === 0 && !(event.metaKey || event.ctrlKey || event.shiftKey || event.altKey);
        opened = plain && !row.target ? index : -1;
      });
    }

    const hide = () => {
      visible = false;
      active = -1;
      preview.style.opacity = '0';
      preview.dataset.visible = 'false';
      start();
    };

    list.addEventListener('pointerleave', hide);

    // Only the cover on show is named for the view transition, at the moment of leaving:
    // a hidden cover never takes part, and coming back to this page morphs nothing.
    window.addEventListener('pageswap', (event) => {
      if (!event.viewTransition || !visible || opened !== active) return;
      const name = covers[opened]?.dataset.transition;
      const cover = covers[opened]?.querySelector<HTMLElement>('.project-cover');
      if (!name || !cover) return;
      cover.style.setProperty('view-transition-name', name);
      cover.style.setProperty('view-transition-class', 'cover');
    });

    // Back from the case study (back/forward cache): start clean.
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      for (const cover of preview.querySelectorAll<HTMLElement>('.project-cover')) {
        cover.style.removeProperty('view-transition-name');
        cover.style.removeProperty('view-transition-class');
      }
      opened = -1;
      hide();
    });
  }
</script>
