---
import { type Locale, localizePath, t } from '../i18n/ui';
import { type Project, projectSlug } from '../lib/content';
import { formatPeriod } from '../lib/dates';
import Badge from './Badge.astro';

/**
 * One row of the selected-work list: number, title and tagline, category and years.
 * Links to the case study, or straight to the project's own site when it has `externalUrl`.
 */
interface Props {
  project: Project;
  index: number;
  locale: Locale;
}

const { project, index, locale } = Astro.props;
const { data } = project;
const external = data.externalUrl;
---

<li class="reveal border-b border-line">
  <a
    href={external ?? localizePath(`/work/${projectSlug(project)}`, locale)}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener' : undefined}
    data-work-row={index}
    class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 py-5 transition-colors hover:bg-bg-elevated/60 sm:grid-cols-[3rem_1fr_auto_auto]"
  >
    <span class="meta text-fg-subtle">{String(index + 1).padStart(2, '0')}</span>
    <span class="transition-transform duration-500 ease-out-expo group-hover:translate-x-1.5">
      <span class="text-subheading">{data.title}</span>
      <span class="text-fg-subtle"> — {data.tagline}</span>
      {
        external && (
          <span class="text-fg-subtle">
            {' '}↗<span class="sr-only">{t(locale, 'work.external')}</span>
          </span>
        )
      }
      {data.draft && <Badge class="ml-2">{t(locale, 'work.draft')}</Badge>}
    </span>
    <span class="meta hidden text-fg-subtle sm:block">{data.category}</span>
    <span class="meta text-fg-subtle">{formatPeriod(data.start, data.end, locale, 'year')}</span>
  </a>
</li>
