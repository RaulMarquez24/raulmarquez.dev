---
import { type Locale, localizePath, otherLocale, t } from '../i18n/ui';

interface Props {
  locale: Locale;
  path: string;
  alternates: readonly Locale[];
}

const { locale, path, alternates } = Astro.props;
const other = otherLocale(locale);
const current = localizePath(path, locale);

const nav = [
  { href: `${localizePath('/', locale)}#work`, label: t(locale, 'nav.work'), match: null },
  { href: localizePath('/about', locale), label: t(locale, 'nav.about'), match: '/about' },
  { href: localizePath('/cv', locale), label: t(locale, 'nav.cv'), match: '/cv' },
];
---

<header class="container-page flex items-center justify-between gap-4 py-5">
  <a href={localizePath('/', locale)} class="text-[15px] font-medium tracking-tight" aria-label={t(locale, 'nav.home')}>
    RMU<span class="text-accent">.</span>
  </a>

  <div class="meta flex items-center gap-4 text-fg-muted sm:gap-6">
    <nav aria-label={t(locale, 'nav.primary')}>
      <ul class="flex items-center gap-4 sm:gap-6">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="transition-colors hover:text-fg aria-[current=page]:text-fg"
                aria-current={item.match && localizePath(item.match, locale) === current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      alternates.includes(other) && (
        <a
          href={localizePath(path, other)}
          hreflang={other}
          lang={other}
          class="rounded-sm px-1 uppercase transition-colors hover:text-fg"
          aria-label={t(locale, 'lang.switchLabel')}
        >
          {other}
        </a>
      )
    }

    <button
      type="button"
      data-theme-toggle
      class="grid size-8 place-items-center rounded-md transition-colors hover:bg-bg-elevated hover:text-fg"
      aria-label={t(locale, 'theme.toggle')}
    >
      <svg class="theme-icon-dark size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
      </svg>
      <svg class="theme-icon-light size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
